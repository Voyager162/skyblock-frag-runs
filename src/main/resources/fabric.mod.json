{
  "schemaVersion": 1,
  "id": "fragruns",
  "version": "${version}",
  "name": "Skyblock Frag Runs",
  "description": "Track and continue Floor VII sessions with saved dungeon maps, itemized run profits and a movable HUD.",
  "authors": ["Skyblock Frag Runs"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.fragruns.FragRunsClient"],
    "modmenu": ["dev.fragruns.ui.ModMenuIntegration"]
  },
  "mixins": ["fragruns.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  }
}
